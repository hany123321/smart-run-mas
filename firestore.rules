rules_version = '2';

// ============================================================
//  قواعد أمان Firestore — حسابات المهندس
// ------------------------------------------------------------
//  ⚠️  مهم جداً: الملف ده لازم تنسخه في:
//      Firebase Console ← Firestore Database ← Rules ← Publish
//      من غير الخطوة دي البيانات بتفضل مفتوحة لأي حد على الإنترنت.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /engineer_accounts/main {

      // ---------- القراءة ----------
      // مفتوحة عشان صفحة المعرض العام (?portfolio=1) تشتغل للعملاء
      // من غير تسجيل دخول.
      //
      // ⚠️  تحذير: ده معناه إن أي شخص معاه رابط المعرض يقدر يفتح
      //     أدوات المطوّر ويقرأ *كل* البيانات — المشاريع، الأرباح،
      //     أسماء العملاء، الفواتير. ده اختيارك المعلن.
      //
      // 🔒 عايز تقفل التسريب ده؟ غيّر السطر ده لـ:
      //        allow read: if request.auth != null;
      //     بس لازم الأول تنقل صور المعرض لمستند عام منفصل،
      //     وإلا صفحة المعرض هتبطل تشتغل عند العملاء.
      allow read: if true;

      // ---------- الكتابة ----------
      // للمستخدمين المسجّلين بس. ده اللي بيمنع أي حد من مسح
      // أو تعديل حساباتك — وهو الحماية الأهم هنا.
      allow write: if request.auth != null;
    }

    // ---------- كل حاجة تانية ممنوعة ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
